    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Cadastrar luthieria + dono",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workshop\": {\"name\": \"Oficina Postman\"},\n  \"owner\": {\"name\": \"Dono da Oficina\", \"email\": \"{{ownerEmail}}\", \"password\": \"{{password}}\"}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Cria a luthieria (tenant) e o primeiro usuário ADMIN. Já devolve os tokens.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dados únicos a cada execução (e-mail e CPF válidos aleatórios)",
                  "const n = Date.now();",
                  "pm.collectionVariables.set('ownerEmail', `dono-${n}@teste.com`);",
                  "pm.collectionVariables.set('luthierEmail', `luthier-${n}@teste.com`);",
                  "const d = [1 + Math.floor(Math.random() * 9)];",
                  "for (let i = 1; i < 9; i++) d.push(Math.floor(Math.random() * 10));",
                  "for (let k = 9; k < 11; k++) {",
                  "  let s = 0;",
                  "  for (let i = 0; i < k; i++) s += d[i] * (k + 1 - i);",
                  "  const r = (s * 10) % 11;",
                  "  d.push(r === 10 ? 0 : r);",
                  "}",
                  "const cpf = d.join('');",
                  "pm.collectionVariables.set('luthierCpf', `${cpf.slice(0,3)}.${cpf.slice(3,6)}.${cpf.slice(6,9)}-${cpf.slice(9)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (e-mail)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{ownerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Quem sou eu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar token (refresh)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O refresh token é rotativo: cada uso devolve um novo par.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', r.accessToken);",
                  "pm.collectionVariables.set('refreshToken', r.refreshToken);"
                ]
              }
            }
          ]
        }
      ]
