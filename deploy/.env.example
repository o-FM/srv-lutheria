# Copie para .env (nunca versione o .env). Gere segredos com: openssl rand -base64 48

# Domínio público (DNS tipo A apontando para o IP do servidor) e e-mail do Let's Encrypt
DOMAIN=app.suaoficina.com.br
ACME_EMAIL=voce@suaoficina.com.br

# Banco
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# API: segredo do JWT (>= 32 bytes) e primeiro admin (criado só se ainda não existir nenhum)
JWT_SECRET=troque-por-openssl-rand-base64-48
ADMIN_EMAIL=voce@suaoficina.com.br
ADMIN_SENHA=troque-senha-com-12-ou-mais

# E-mail transacional: copie smtp.env.example para smtp.env (opcional, mas recomendado).

# Backups do banco (pasta no servidor) e retenção
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
TZ=America/Sao_Paulo

# Imagens prontas do GitHub Container Registry (CI). Para compilar no servidor: --build
# API_IMAGE=ghcr.io/o-fm/srv-lutheria:latest
# WEB_IMAGE=ghcr.io/o-fm/srv-lutheria-front:latest
# FRONT_PATH=../../srv-lutheria-front
