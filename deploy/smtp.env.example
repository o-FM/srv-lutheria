# E-mail transacional (recuperação de senha, avisos de OS e orçamento).
# Copie para smtp.env. Exemplos: Brevo (300/dia grátis), Resend, Amazon SES (US$ 0,10/1000).
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=seu-usuario-smtp
SPRING_MAIL_PASSWORD=sua-chave-smtp
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
LUTHIERIA_MAIL_FROM=Oficina <nao-responda@suaoficina.com.br>
